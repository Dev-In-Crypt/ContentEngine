# Copy this file to  .env  (same folder as docker-compose.yml) and fill it in.
# .env is gitignored — never commit real secrets.

# Your domain. Its DNS A-record MUST point to this VPS's public IP, and ports
# 80 + 443 must be open, or Caddy can't get an HTTPS certificate.
DOMAIN=engine.example.com

# Hostnames that should REDIRECT to DOMAIN rather than serve the app: www, and
# the old address while you move to a new one. Comma-separated; leave empty if
# you have neither.
#
# A redirect rather than a second copy, because two hostnames are two origins
# and the session token lives in localStorage — signing in on www would leave
# the apex looking logged out.
ALIAS_DOMAINS=www.engine.example.com

# Strong, STABLE secret. Signs login tokens AND derives the key that encrypts
# every user's stored API keys. NEVER change it after go-live (rotating it logs
# everyone out and makes all stored keys undecryptable).
# Generate one:  openssl rand -base64 48
SECRET_KEY=

# Postgres password (any strong random string).
DB_PASSWORD=

# Your email(s), comma-separated → granted admin (DB backup/restore) on boot.
ADMIN_EMAILS=you@example.com

# Only needed to publish Reels (Instagram fetches the video by public URL).
PUBLIC_BASE_URL=https://engine.example.com

# Email (Resend) — verification + password reset. Empty = emails are only logged.
# Keep REQUIRE_VERIFIED_EMAIL=false until you have a verified sending domain in
# Resend, otherwise sign-ups can't publish (shared sender = poor deliverability).
RESEND_API_KEY=
EMAIL_FROM=Content Engine <onboarding@resend.dev>
REQUIRE_VERIFIED_EMAIL=false

# Optional: Sentry DSN for backend error monitoring. Empty = disabled.
# Not a secret in the usual sense — it only lets a client SEND events — but it is
# still worth keeping out of the repo. Errors are tagged with APP_MODE as the
# environment and never carry personal data (send_default_pii is off, and there
# is a test holding it there).
SENTRY_DSN=

# ── The platform's own AI key (optional, and it costs YOU money) ──────────────
# Everyone who signs up brings their own key for their own work. This one pays
# for the three things the product gives away BEFORE anybody has a key:
#   • the post written at the end of onboarding,
#   • five free generations per new account,
#   • the landing page that writes a post for a visitor who has not signed up.
# Leave it empty and all three answer "temporarily unavailable" — the product
# still works, newcomers just meet the key question sooner.
OPENROUTER_API_KEY=

# The daily ceiling on that giveaway, in dollars, across every free and
# anonymous generation. Worst case is about $1.50 per registered account
# (5 generations x up to 10 AI images), so 10 is roughly seven such accounts a
# day. Not transactional: simultaneous requests can overshoot it by one
# generation each. Ignored entirely when OPENROUTER_API_KEY is empty.
APP_DAILY_SPEND_USD=10

# Which models the PLATFORM key pays for. Only used for the giveaway above —
# a tenant's own generations use the models they chose in their own settings.
DEFAULT_TEXT_MODEL=anthropic/claude-sonnet-4
DEFAULT_IMAGE_MODEL=google/gemini-2.5-flash-image-preview

# How many days of daily DB dumps the `backup` service keeps (default 7).
BACKUP_KEEP_DAYS=7
